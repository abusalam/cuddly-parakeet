# Environment Configuration
NODE_ENV=development

# API Configuration
# For development: http://localhost:5000/api
# For production: https://your-app-domain.com/api
# VITE_API_BASE_URL=http://lithium_service.test:81/api
# VITE_API_BASE_URL=https://lithiumbatteryservice.rtcsindia.co.in/api
#VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_API_BASE_URL=http://api.healrx.test/api/v1/


FILESYSTEM_DRIVER=public
# App Configuration
VITE_APP_NAME=Admin Panel
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Production-ready React.js Admin Panel

# Database Configuration (for backend)
DATABASE_URL=your_database_url_here

# Authentication
VITE_TOKEN_STORAGE_KEY=adminToken
VITE_SESSION_TIMEOUT=3600000
VITE_ENABLE_AUTO_LOGOUT=true

# Features
VITE_ENABLE_DEBUG=true
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_TOAST_NOTIFICATIONS=true
VITE_ENABLE_OFFLINE_MODE=false

# Performance
VITE_API_TIMEOUT=30000
VITE_RETRY_ATTEMPTS=3
VITE_CACHE_TIMEOUT=300000

# External Services (add your API keys here)
# VITE_STRIPE_PUBLIC_KEY=pk_test_...
# VITE_GOOGLE_MAPS_API_KEY=...
# VITE_ANALYTICS_ID=...
# VITE_SENTRY_DSN=...

# Deployment Configuration
VITE_DEPLOYMENT_ENV=development
VITE_BUILD_TIMESTAMP=
VITE_GIT_COMMIT_HASH=